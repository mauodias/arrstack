.env
config/*
# Exception: Homepage's dashboard config is human-authored infrastructure,
# not runtime state, so it is tracked in git unlike every other config/* dir.
!config/homepage/
config/homepage/*
!config/homepage/services.yaml
!config/homepage/settings.yaml
!config/homepage/widgets.yaml
!config/homepage/custom.css
# Exception: soularr's config.ini template is a human-authored, secret-free
# placeholder committed to the repo; bootstrap fetches it and substitutes
# real API keys from the environment to produce the runtime config.ini.
# Exception: alert thresholds are human-authored infrastructure, fetched from
# GitHub by bootstrap/init.sh the same way the Homepage config is.
!config/alerts/
config/alerts/*
!config/alerts/rules.toml
!config/soularr/
config/soularr/*
!config/soularr/config.ini.template
# Exception: library-seed is human-authored code mounted into Sonarr and
# Radarr as a Custom Script, fetched by bootstrap/init.sh like the rest.
!config/scripts/
config/scripts/*
!config/scripts/library_seed.py
data/
__pycache__/
*.pyc

# Local diagnostic scripts (contain no secrets, but are scratch work)
.claude/
